# Bundler cache
.bundle
vendor

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Open Graph images, generated into the source tree at build time by
# jekyll-og-image and served from _site. Not committed. The site-wide default
# card lives outside this directory, at assets/img/og-default.png, so it stays
# tracked without needing a gitignore negation.
assets/img/og

# Misc
_sass/vendors
assets/js/dist
.DS_Store

# Claude Code local state
.claude
