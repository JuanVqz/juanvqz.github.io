---
layout: null
permalink: /devto.xml
# RSS 2.0 feed for the dev.to "Publishing to DEV from RSS" import.
#
# feed.xml only carries a 90-word <summary>, and its <content> is an empty
# link, so dev.to imported every post cut short. dev.to reads
# <content:encoded> first and falls back to <description>, so this feed puts
# the full post HTML there.
#
# Kept separate from feed.xml on purpose: the GitHub profile README reads that
# one, and its final `replace: '&', '&amp;'` would corrupt the escaped
# entities inside code blocks if it carried full HTML.
#
# No entry limit: dev.to skips posts it already has (same title or same link),
# so a deleted draft is imported again on the next fetch only while its post
# is still in this feed.
---
{%- assign site_url = site.url | append: site.baseurl -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ "/" | absolute_url }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>{{ site.lang }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
{%- for post in site.posts %}
  {%- assign post_url = post.url | absolute_url %}
  {%- assign body = post.content | devto_html: site_url %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post_url }}</link>
      <guid isPermaLink="true">{{ post_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    {%- for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
    {%- endfor %}
      <description>{{ post.description | default: post.excerpt | strip_html | strip_newlines | truncatewords: 60 | xml_escape }}</description>
      <content:encoded>{{ body | xml_escape }}</content:encoded>
    </item>
{%- endfor %}
  </channel>
</rss>
